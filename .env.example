# Copy to .env and fill in. .env is gitignored; never commit real values.

# From the app registration in Microsoft Entra (Overview page)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Comma-separated work emails that get the admin role
ADMIN_EMAILS=admin@yourtenant.onmicrosoft.com

# Where the dashboard runs; the only origin the API accepts requests from
ALLOWED_ORIGIN=http://localhost:5173
