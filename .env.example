# Copy to .env and fill in. .env is gitignored; never commit real values.

# From the app registration in Microsoft Entra (Overview page)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The same two IDs again, for the dashboard. Vite only passes variables that
# start with VITE_ to the browser, so these are the only ones it can see
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Where the dashboard runs; the only origin the API accepts requests from
ALLOWED_ORIGIN=http://localhost:5173

# The LiteLLM proxy that writes the titles of the question clusters. The question
# text is sent there, so it has to be a service approved for HR data
LITELLM_API_URL=https://litellm.example.org
LITELLM_API_KEY=sk-replace-me
LITELLM_MODEL=model-name-on-the-proxy

# The PostgreSQL database. Docker Compose creates it from these values and the
# API reaches it as "db"; DBHOST is only used when the API runs outside Docker
DBNAME=kunnskapsgap
DBUSER=kunnskapsgap
DBPASSWORD=replace-me
DBHOST=localhost

# Encrypts the stored snapshots, so losing it makes them unreadable. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNAPSHOT_KEYS=replace-me
